{
  "name": "portal-os1",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/pages",
    "apps/worker",
    "max-core"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:pages": "npm run dev -w @portal/pages",
    "dev:worker": "wrangler dev --port 8787",
    "build": "npm run build -w @portal/pages",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run && npm run test -w max-core",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file apps/worker/d1/seed.sql",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy apps/pages/dist --project-name portal-os1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "type": "module",
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  }
}
